@model List<WebApplication1.Models.Phone>

@{
    ViewData["Title"] = "Index";
}

<h1>Phones</h1>
<div class="mb-3">
    <a asp-action="Create" class="btn btn-success">Create new Phone</a>
</div>

@if (Model.Count == 0)
{
    <p>There are no phones yet</p>
}
else
{
    <table class="table align-middle">
        <thead>
        <tr>
            <th>Name</th>
            <th>Company</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>@item.Name</td>
                <td>@item.Company</td>
                <td>$@item.Price</td>
                <td>
                    <a asp-action="Create" asp-controller="Order" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Order</a>
                    
                    <a asp-action="DownloadSpecs" asp-controller="Phone" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                        Скачать описание
                    </a>
                    
                    <a asp-action="RedirectToCompany" asp-controller="Phone" asp-route-id="@item.Id" target="_blank" class="btn btn-sm btn-outline-info">
                        Сайт производителя
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}